{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.nuxt/**)",
      "Read(./.output/**)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./**/*.min.js)",
      "Read(./pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-rtl.sh"
          }
        ]
      }
    ]
  }
}

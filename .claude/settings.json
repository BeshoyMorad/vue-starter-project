{
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm test:unit --run:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm locales:types:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm --filter:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git merge-base:*)",
      "Bash(ls:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(pnpm add:*)", "Bash(pnpm remove:*)", "Bash(pnpm install:*)"],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/.nuxt/**)",
      "Read(**/.output/**)",
      "Read(**/.turbo/**)",
      "Read(**/coverage/**)",
      "Read(**/*.min.js)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/.env)",
      "Read(**/graphify-out/cache/**)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh"
          }
        ]
      }
    ]
  }
}
